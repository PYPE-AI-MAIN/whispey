# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-only: Pi/MCP routes calling back into this Next app (defaults to http://127.0.0.1:$PORT in dev)
# INTERNAL_APP_URL=http://127.0.0.1:3000

# Supabase (server-only — never exposed to the browser; do not use NEXT_PUBLIC_ for URL)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: legacy migration only; prefer SUPABASE_URL above
# NEXT_PUBLIC_SUPABASE_URL=

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
CLERK_WEBHOOK_SIGNING_SECRET=

# OpenAI (for transcript field extraction)
OPENAI_API_KEY=
# Optionally override model used by transcript processor
# OPENAI_MODEL=gpt-4o

# Azure OpenAI (defaults for agent LLM)
OPENAI_API_VERSION=2024-12-01-preview
AZURE_DEPLOYMENT_NAME=gpt-4.1-mini-2
AZURE_OPENAI_ENDPOINT=https://pype-azure-openai.cognitiveservices.azure.com/
# AZURE_OPENAI_API_KEY=  (set in .env.local — never commit)

# Pi org assistant — optional extra system instructions (appended server-side)
# PI_SYSTEM_PROMPT_APPEND=Always recommend checking Org Overview for trends.

# VAPI encryption (used for securing Vapi credentials)
VAPI_MASTER_KEY=

# Optional: Public API base URL
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Voice backend — pype-voice-agent (FastAPI, default port 8080 per its README)
# Server routes prefer PYPEAI_API_URL so local dev can use localhost without exposing it in the client bundle.
# PYPEAI_API_URL=http://127.0.0.1:8080
# NEXT_PUBLIC_PYPEAI_API_URL=http://127.0.0.1:8080
# Auth: dashboard sends Authorization: Bearer <service JWT> (mintServiceToken). Must match voice agent PYPE_JWT_SECRET.
# Legacy x-api-key only works on the voice agent when ALLOW_X_API_KEY=true there; default is JWT-only.
# NEXT_PUBLIC_X_API_KEY=pype-api-v1

# Pipecat API (for Pipecat agent creation and management)
PIPECAT_BASE_URL=

# Shared with pype-voice-agent for service JWT (audience pype-vc-bots) and SSO validation
PYPE_JWT_SECRET=

# Pi MCP create (POST /api/mcp/agents) — must match AGENT_STUDIO_SECRET in Pi chat route
# AGENT_STUDIO_SECRET=

# Optional: AWS (used by audio routes if you enable S3 storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

# ElevenLabs webhook (POST /api/elevenlabs/webhook) - forwards to HOST_URL only
ELEVENLABS_WEBHOOK_SECRET=
HOST_URL=
WHISPEY_API_KEY=
ELEVENLABS_AGENT_ID=

# Raya (Bakbak) TTS — server-side only. Powers the voice list and previews in the TTS dialog
# (the agent workers read their own RAYA_API_KEY from the pype-voice-agent-be secrets).
RAYA_API_KEY=
# Optional: override the Raya API host (default https://hub.getraya.app)
# RAYA_BASE_URL=

# Pi's spam checker — internal Scam Checker service (EC2 "pype-internal-services", https://scam-check.pypeai.com).
# Its bearer is a short-lived JWT, so prefer client credentials: Pi fetches and refreshes the token itself.
# SCAM_CHECK_CLIENT_ID=
# SCAM_CHECK_CLIENT_SECRET=
# Or a fixed token (cannot refresh — expires and must be replaced by hand):
# SCAM_CHECK_TOKEN=
# SCAM_CHECK_URL=https://scam-check.pypeai.com
